# Common ports and credentials
POSTGRES_DB=tgo
POSTGRES_USER=tgo
POSTGRES_PASSWORD=tgo
POSTGRES_PORT=5432

ENVIRONMENT=PRODUCTION

# API base URL (for frontend to call backend)
# When using Nginx reverse proxy, use the Nginx URL
VITE_WIDGET_PREVIEW_URL=/widget/
VITE_WIDGET_SCRIPT_BASE=/widget/tgo-widget-sdk.js
VITE_WIDGET_DEMO_URL=/widget/demo.html
VITE_API_BASE_URL=/api
VITE_DEBUG_MODE=false

# Store
STORE_SERVICE_URL=https://store.tgo.ai
STORE_WEB_URL=https://store.tgo.ai

# Redis port
REDIS_PORT=6379


# Service internal ports (not exposed to host, only accessible through Nginx)
# These are used for inter-service communication within Docker network
API_PORT=8000
AI_PORT=8002
PLATFORM_PORT=8003
RAG_PORT=8082
WEB_PORT=3000


# WuKongIM Config
WK_EXTERNAL_IP=
WK_EXTERNAL_TCPADDR=
WK_EXTERNAL_WSADDR=
WK_EXTERNAL_WSSADDR=

# ============================================
# Domain Configuration (Optional)
# ============================================
# Set these to enable domain-based access with Nginx reverse proxy
# Leave empty or commented out to use direct port access

# Domain names for services
WEB_DOMAIN=
WIDGET_DOMAIN=
API_DOMAIN=

# SSL Configuration
# Options: none (no SSL), auto (Let's Encrypt), manual (custom certificates)
SSL_MODE=none

# Let's Encrypt email (required for SSL_MODE=auto)
SSL_EMAIL=

# Enable automatic SSL certificate renewal (for SSL_MODE=auto)
ENABLE_SSL_AUTO_RENEW=true

# Nginx ports (only Nginx is exposed to host)
# All other services (tgo-api, tgo-web, tgo-widget-js) are only accessible through Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443

# nginx file size limit
NGINX_CLIENT_MAX_BODY_SIZE=100m


# ============================================
# Storage Configuration
# ============================================
# STORAGE_TYPE options: local, oss, minio
STORAGE_TYPE=local

# Aliyun OSS Configuration
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET_NAME=your-bucket-name
# OSS_BUCKET_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret

# MinIO Configuration
# MINIO_URL=http://your-minio-host:9000
# MINIO_ACCESS_KEY_ID=your-access-key-id
# MINIO_SECRET_ACCESS_KEY=your-secret-access-key
# MINIO_BUCKET_NAME=your-bucket-name
# MINIO_UPLOAD_URL=http://internal-minio:9000
# MINIO_DOWNLOAD_URL=https://public-minio-domain.com


# ============================================
# SMTP Configuration (Optional - for email notifications)
# ============================================
# TGO_SMTP_HOST=smtp.example.com
# TGO_SMTP_PORT=587
# TGO_SMTP_USERNAME=your-username
# TGO_SMTP_PASSWORD=your-password
# TGO_SMTP_USE_TLS=true
# TGO_SMTP_FROM_ADDRESS=noreply@example.com


# ============================================
# Advanced Settings (Optional)
# ============================================
# Short-lived access token and long-lived HttpOnly refresh cookie.
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=30
# REFRESH_COOKIE_NAME=tgo-refresh-token
# Keep false for HTTP; change to true after HTTPS is enabled.
# REFRESH_COOKIE_SECURE=false
# Public HTTPS origin used by the WeCom OAuth/JSSDK jump page.
# API_BASE_URL=https://support.example.com

# Maximum file upload size in MB (default: 20)
# MAX_UPLOAD_SIZE_MB=20

# Log level (default: INFO)
# LOG_LEVEL=INFO

# Managed WorkTool / WeCom smart-bot connection control
AI_REPLY_FROZEN=true
CHANNEL_GATEWAY_HOST_ALLOWLIST=worktool-gateway,worktool-gateway.internal
WECOM_WS_URL_ALLOWLIST=wss://openws.work.weixin.qq.com
WORKTOOL_CONTROL_TOKEN=replace-with-strong-internal-token
# Exact group and robot allowlist for the explicit AI test reply chain.
WORKTOOL_AI_TEST_ENABLED=false
WORKTOOL_AI_TEST_GROUPS=AI测试
WORKTOOL_AI_TEST_ROBOT_ID=
AIBOT_CONTROL_TOKEN=replace-with-strong-internal-token
WECOM_AIBOT_CONTROL_URL=http://wecom-aibot-sender:8791
# Required before the guarded old-platform reset button can delete anything.
CHANNEL_DATA_BACKUP_URL=http://backup-service.internal/v1/platform-backups
WUKONGIM_CHANNEL_PURGE_URL=http://wukong-maintenance.internal/v1/channel-purge
CHANNEL_DATA_MAINTENANCE_TOKEN=replace-with-strong-maintenance-token

# WorkTool gateway process (set on the gateway host, not in browser code):
# WT_TGO_MEDIA_CALLBACK_URL=http://tgo-api:8000/v1/reply-monitor/media
# WT_TGO_MEDIA_RECOVERY_CALLBACK_URL=http://tgo-api:8000/v1/reply-monitor/media-recovery/jobs
# WT_TGO_CALLBACK_TOKEN must equal this WorkTool platform's API key.
# The self-built WeCom platform config must contain corp_id, agent_id,
# app_secret and customer_contact_secret. Never expose them through VITE_*.
